<div class="search-container">
    <input type="text" id="searchInput" class="search-bar" placeholder="Szukaj wpisów...">
</div>

<main class="posts-list" id="postsList">
    {% for post in collections.posts %}
        <article class="post-card">
            {% if post.data.image %}
                <div class="post-image" data-lightbox-src="{{ post.data.image }}">
                    <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
                </div>
            {% endif %}

            <div class="post-content">
                <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
                <div class="post-meta-line">
                    <span class="date">{{ post.date | date: "%d.%m.%Y" }}</span>
                    <span>{{ post.templateContent | readingTime }} min czytania</span>
                </div>
                {% assign visibleTags = post.data.tags %}
                {% unless visibleTags %}{% assign visibleTags = post.templateContent | postTags %}{% endunless %}
                {% if visibleTags.size > 0 %}
                    <div class="post-tags" aria-label="Tagi wpisu">
                        {% for tag in visibleTags %}<span>#{{ tag }}</span>{% endfor %}
                    </div>
                {% endif %}
                <div class="excerpt">
                    {{ post.data.page.excerpt }}
                    <p><a href="{{ post.url }}" class="read-more">Czytaj dalej...</a></p>
                </div>
            </div>
        </article>
    {% else %}
        <p class="empty-blog">Brak wpisów. Nowe artykuły pojawią się wkrótce!</p>
    {% endfor %}
</main>
<div id="noResultsMessage" class="no-results">Nie znaleziono wpisów spełniających kryteria.</div>
